# Copy this file to .env and fill in your own values
# NEVER commit the real .env file

# Telegram Bot token — get from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your personal Telegram chat ID — the bot will ONLY talk to this ID
# Get it by messaging @userinfobot on Telegram
CHAT_ID=123456789

# Google Sheets ID — the long string in your Sheet URL
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
SHEET_ID=your_sheet_id_here

# ── Google Credentials ───────────────────────────────────────────────────────
# Railway / cloud deploy: dùng GOOGLE_CREDS_JSON (paste toàn bộ nội dung credentials.json)
# Cách lấy: cat credentials.json | tr -d '\n'  → copy chuỗi JSON 1 dòng vào đây
GOOGLE_CREDS_JSON={"type":"service_account","project_id":"...","private_key_id":"..."}

# Local deploy: dùng đường dẫn file (bỏ qua nếu đã set GOOGLE_CREDS_JSON)
# GOOGLE_CREDS=credentials.json

# ── Security Tokens (REQUIRED) ──────────────────────────────────────────────
# Tất cả 3 token dưới đây BẮT BUỘC phải set. Bot sẽ KHÔNG start nếu thiếu.

# Telegram webhook secret — dùng chuỗi random (vd: openssl rand -hex 32)
# Phải khớp với secret_token khi gọi setWebhook API:
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://<domain>/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_WEBHOOK_SECRET=your_random_tg_secret_here

# SePay webhook secret — khớp với API Key trong SePay dashboard
# Bước: my.sepay.vn → Cài đặt → Webhook → API Key
SEPAY_SECRET=your_sepay_api_key_here

# Cron trigger secret — bảo vệ /trigger/* endpoints
# Dùng trong URL cron: https://<domain>/trigger/daily-recap?secret=<CRON_SECRET>
CRON_SECRET=your_random_cron_secret_here

# ── SePay Webhook Setup ──────────────────────────────────────────────────────
# Bước 1: Đăng nhập my.sepay.vn → Cài đặt → Webhook
# Bước 2: Điền URL webhook:
#   https://<railway-domain>/webhook
#   VD: https://financial-tracking-bot-production.up.railway.app/webhook
# Bước 3: Chọn "Gửi tất cả giao dịch" (cả tiền vào và tiền ra)
# Bước 4: Điền API Key vào SePay dashboard VÀ set SEPAY_SECRET ở trên (BẮT BUỘC)
#
# Bot sẽ nhận webhook cho MỌI giao dịch:
#   - Tiền ra (debit): hiện thông báo đỏ + yêu cầu phân loại
#   - Tiền vào (credit): hiện thông báo xanh + tùy chọn phân loại
