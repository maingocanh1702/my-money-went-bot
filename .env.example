# Copy this file to .env and fill in your own values
# NEVER commit the real .env file

# Telegram Bot token — get from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your personal Telegram chat ID — the bot will ONLY talk to this ID
# Get it by messaging @userinfobot on Telegram
CHAT_ID=123456789

# Google Sheets ID — the long string in your Sheet URL
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
SHEET_ID=your_sheet_id_here

# ── Google Credentials ───────────────────────────────────────────────────────
# Railway / cloud deploy: dùng GOOGLE_CREDS_JSON (paste toàn bộ nội dung credentials.json)
# Cách lấy: cat credentials.json | tr -d '\n'  → copy chuỗi JSON 1 dòng vào đây
GOOGLE_CREDS_JSON={"type":"service_account","project_id":"...","private_key_id":"..."}

# VPS / local deploy: dùng file credentials.json thay vì GOOGLE_CREDS_JSON.
# GOOGLE_CREDS=credentials.json

# ── SePay Webhook Setup ──────────────────────────────────────────────────────
# Bước 1: Đăng nhập my.sepay.vn → Cài đặt → Webhook
# Bước 2: Điền URL webhook:
#   https://<railway-domain>/webhook
#   VD: https://your-app.up.railway.app/webhook
# Bước 3: Chọn "Gửi tất cả giao dịch" (cả tiền vào và tiền ra)
# Bước 4: Tạo API Key ngẫu nhiên, điền cùng giá trị vào SePay dashboard và
# SEPAY_SECRET bên dưới. Production sẽ không khởi động nếu thiếu secret này.
#
# Bot sẽ nhận webhook cho MỌI giao dịch:
#   - Tiền ra (debit): hiện thông báo đỏ + yêu cầu phân loại
#   - Tiền vào (credit): hiện thông báo xanh + tùy chọn phân loại
#
SEPAY_SECRET=

# ── Telegram Webhook Secret (required in production) ─────────────────────────
# Production chỉ nhận Telegram updates có header khớp secret này.
# Bước 1: Tạo chuỗi random (vd: openssl rand -hex 32) → điền bên dưới
# Bước 2: Đăng ký lại webhook với CÙNG giá trị:
#   curl -X POST "https://api.telegram.org/bot<BOT_TOKEN>/setWebhook" \
#     -d "url=https://<railway-domain>/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_WEBHOOK_SECRET=

# ── Cron Trigger Secret (required in production) ─────────────────────────────
# /trigger/* yêu cầu ?secret=<value>; cập nhật crontab.txt cùng giá trị này.
CRON_SECRET=

# ── Email Webhook Setup ──────────────────────────────────────────────────────
# Bot nhận email thông báo biến động số dư từ ngân hàng (vd Cake) qua Google Apps Script
# Bước 1: Tạo EMAIL_SECRET (bất kỳ chuỗi random nào, vd: openssl rand -hex 16)
# Bước 2: Điền vào đây VÀ vào Google Apps Script (WEBHOOK_SECRET)
# Bước 3: Deploy Google Apps Script và set trigger mỗi 1 phút
EMAIL_SECRET=

# ── Merchant name learning (optional) ────────────────────────────────────────
# Chuyển khoản ngân hàng VN luôn kèm TÊN NGƯỜI GỬI trong nội dung. Thêm tên
# của bạn (không dấu, cách nhau bởi dấu phẩy) để bot không học nhầm tên bạn
# thành tên merchant khi tạo keyword rule.
# MERCHANT_NOISE_WORDS=nguyen,van,an

# ── SePay identity upgrade (transitional) ────────────────────────────────────
# Giao dịch giờ được định danh bằng chính `id` của SePay. Một retry vắt qua lúc
# nâng cấp sẽ mang định danh mới cho dòng đã ghi bằng reference cũ, nên bot tra
# cả hai key. Tắt sau khi đã qua cửa sổ retry của SePay kể từ lần deploy đó.
# SEPAY_LEGACY_REF_LOOKUP=true

# ── Mốc bắt đầu ghi nhận giao dịch (khuyên dùng) ─────────────────────────────
# Ngày (hoặc thời điểm) mà bot bắt đầu "sở hữu" giao dịch của bạn — ISO:
#   2026-09-01   hoặc   2026-09-01T00:00:00
# Lý do tồn tại: lần đầu đăng ký webhook, nhà cung cấp thường replay lại lịch
# sử cũ; phần lịch sử đó không phải của lần cài đặt này.
#
# Tuổi giao dịch KHÔNG phải là cơ chế chống replay — định danh trong sổ claim
# mới là. Nên khi đặt mốc này, giao dịch chỉ bị loại nếu xảy ra TRƯỚC mốc: một
# giao dịch đến muộn vì bot down, vì Gmail poll chậm hay vì provider retry vài
# ngày sau vẫn được ghi, thay vì bị vứt đi.
#
# Giá trị sai định dạng sẽ bị bỏ qua (kèm log) chứ không loại sạch mọi giao
# dịch. Để trống thì hai cửa sổ theo tuổi bên dưới đóng vai trò chặn replay.
# INGESTION_START_AT=2026-09-01

# ── Stale-transaction guard (chỉ dùng khi INGESTION_START_AT để trống) ───────
# Webhook tx cũ hơn cửa sổ này (phút) sẽ bị loại — chặn SePay replay lịch sử
# khi mới setup webhook. Nếu bot có thể down lâu hơn 10 phút (deploy, sự cố),
# tăng TX_MAX_AGE_MINUTES để SePay retry đến muộn không bị loại.
# TX_MAX_AGE_MINUTES=10
# EMAIL_TX_MAX_AGE_MINUTES=10080

# Mọi giao dịch bị loại (quá cũ, trước mốc, hay trùng chéo nguồn) đều được ghi
# lại vào tab "Excluded Events" trong Google Sheet — kèm lý do — để không có
# giao dịch nào biến mất không dấu vết.

# ── Zalo Bot Setup ─────────────────────────────────────────────────────────────
# Tạo bot: mở Zalo → tìm "Zalo Bot Manager" → Tạo bot
# Docs: https://bot.zapps.me/docs/create-bot/
#
# Bước 1: Tạo bot → nhận Bot Token qua tin nhắn Zalo
# Bước 2: Vào Thiết lập chung → điền Webhook URL:
#   https://<railway-domain>/zalo/webhook
# Bước 3: Tạo Secret Token (8-256 ký tự) → điền ZALO_SECRET_TOKEN
# Bước 4: Nhắn tin cho bot trên Zalo → check server logs lấy sender_id → điền ZALO_CHAT_ID
#
# ZALO_ENABLED=true
# ZALO_BOT_TOKEN=your_bot_token_here
# ZALO_SECRET_TOKEN=your_webhook_secret_token_here
# ZALO_ALLOW_UNVERIFIED_WEBHOOK=false  # test-only; always false in production
# ZALO_CHAT_ID=123456789
# ZALO_TEXT_LIMIT=2000
